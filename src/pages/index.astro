---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import CTAButton from "../components/CTAButton.astro";
import AtmosphereStrip from "../components/AtmosphereStrip.astro";
import site from "../data/site.json";
import heroFruehstueck from "../assets/images/hero-fruehstueck-flatlay.webp";
import cardSpeisekarte from "../assets/images/card-speisekarte.webp";
import cardKuchen from "../assets/images/card-kuchen.webp";
import cardUeberUns from "../assets/images/card-ueber-uns.webp";
import cardMittagsmenue from "../assets/images/card-mittagsmenue.webp";
import unsereGeschichte from "../assets/images/unsere-geschichte.jpg";
---

<!--
  TODO: Alle Fotos auf dieser Seite (Hero, Highlight-Cards) sind lizenzfreie
  Unsplash-Stockfotos als Platzhalter. Vor dem Launch durch eigene
  Café-Fotos ersetzen.
-->
<!-- TODO: /og/og-home.jpg noch erstellen (1200x630) -->
<BaseLayout
  title="Rhesi Café & Restaurant Lustenau | Frühstück, Kaffee & mehr"
  description="Gemütliches Café & Restaurant im Rheincenter Lustenau: Frühstück, Kaffeespezialitäten, Kuchen und wechselndes Mittagsmenü Mo–Sa."
  ogImage="/og/og-home.jpg"
>
  <Hero
    image={heroFruehstueck}
    imageAlt="Gedeckter Frühstückstisch mit frischem Obst, Pancakes und Kaffee bei Rhesi"
    headline="Ihr Café mitten in Lustenau"
    subline="Frühstück, leckerer Kuchen, Kaffeespezialitäten und wechselnde Mittagsmenüs – mitten im Rheincenter, von Montag bis Samstag für Sie da."
    ctas={[
      { label: "Speisekarte ansehen", href: "/speisekarte", variant: "primary" },
      { label: "Mittagsmenü", href: "/mittagsmenues", variant: "secondary" },
    ]}
  />

  <section data-reveal="up" class="mx-auto max-w-4xl px-6 py-16 text-center">
    <h2 class="font-heading text-3xl font-semibold text-brown">
      Willkommen im Rhesi
    </h2>
    <p class="mt-4 text-espresso/80 leading-relaxed">
      Im Rhesi Café &amp; Restaurant im Rheincenter Lustenau erwartet Sie
      eine gemütliche Auszeit vom Alltag: frisch gebrühter Kaffee,
      leckerer Kuchen, ein herzhaftes Frühstück und mittags ein
      wechselndes Menü aus der Küche – ganz ohne Hektik.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <h2 class="font-heading text-center text-3xl font-semibold text-brown">
      Entdecken Sie Rhesi
    </h2>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <Card
        image={heroFruehstueck}
        imageAlt="Frühstückstisch mit frischem Obst und Pancakes bei Rhesi"
        title="Frühstück"
        text="Von der Klassik bis zum Avocado Toast – starten Sie entspannt in den Tag."
        href="/speisekarte"
        linkLabel="Zur Speisekarte"
        reveal="left"
      />
      <Card
        image={cardSpeisekarte}
        imageAlt="Latte Art bei Rhesi"
        title="Kaffee"
        text="Espresso, Cappuccino & Co. – Kaffeespezialitäten aus unserer Hausröstung."
        href="/speisekarte"
        linkLabel="Zur Speisekarte"
        reveal="up"
      />
      <Card
        image={cardKuchen}
        imageAlt="Auswahl an hausgemachten Torten und Kuchen bei Rhesi"
        title="Kuchen"
        text="Hausgemachte Torten und Klassiker wie Apfelstrudel und Sachertorte."
        href="/speisekarte"
        linkLabel="Zur Speisekarte"
        reveal="right"
      />
      <Card
        image={cardUeberUns}
        imageAlt="Gemütliche Terrassen-Atmosphäre im Rhesi"
        title="Terrasse"
        text="Gemütliche Atmosphäre drinnen wie draußen – ideal zum Verweilen."
        href="/kontakt"
        linkLabel="Anfahrt"
        reveal="left"
      />
      <Card
        image={cardMittagsmenue}
        imageAlt="Herzhaftes Mittagsgericht im Rhesi"
        title="Mittagsmenü"
        text={`${site.lunchMenu.days} servieren wir ein wechselndes Mittagsmenü mit Suppe und Hauptspeise.`}
        href="/mittagsmenues"
        linkLabel="Zu den Mittagsmenüs"
        reveal="right"
      />
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2">
      <Image
        data-reveal="left"
        src={unsereGeschichte}
        alt="Gemütlicher Gastraum im Rhesi Café & Restaurant mit Sitzecke und Fliesenwand"
        width={800}
        height={600}
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl object-cover"
      />
      <div data-reveal="right">
        <h2 class="font-heading text-3xl font-semibold text-brown">
          Unsere Geschichte
        </h2>
        <p class="mt-4 text-espresso/80 leading-relaxed">
          Platzhaltertext: Geschichte vom Rhesi oder passender Text &amp; Restaurant – von der Gründung bis heute. Echte Inhalte
          folgen im nächsten Schritt.
        </p>
        <div class="mt-8">
          <CTAButton href="/ueber-uns" variant="secondary">
            Unsere Geschichte lesen
          </CTAButton>
        </div>
      </div>
    </div>
  </section>

  <AtmosphereStrip />

  <section class="bg-terracotta">
    <div data-reveal="up" class="mx-auto max-w-6xl px-6 py-16 text-center">
      <h2 class="font-heading text-3xl font-semibold text-white">
        Besuchen Sie uns im Rheincenter Lustenau
      </h2>
      <p class="mt-4 text-white/90">
        {site.openingHoursShort.map((entry) => `${entry.days} ${entry.hours}`).join(" · ")}
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <CTAButton href="/mittagsmenues" variant="secondary" onDark>
          Mittagsmenü ansehen
        </CTAButton>
        <CTAButton href="/kontakt" variant="secondary" onDark>
          Kontakt & Anfahrt
        </CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
