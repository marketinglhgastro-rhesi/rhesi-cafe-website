---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Datenschutz | Rhesi Café & Restaurant"
  description="Datenschutzerklärung des Rhesi Café & Restaurant."
>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Datenschutz</h1>
    <div class="mt-6 space-y-6 text-espresso/80 leading-relaxed">
      <p>
        Platzhaltertext: Hier folgt die vollständige Datenschutzerklärung
        gemäß DSGVO.
      </p>
      <h2 class="font-heading text-xl font-semibold text-brown">
        Verantwortlicher
      </h2>
      <p>Platzhaltertext: Name und Kontaktdaten des Verantwortlichen.</p>
      <h2 class="font-heading text-xl font-semibold text-brown">
        Datenverarbeitung
      </h2>
      <p>Platzhaltertext: Art, Umfang und Zweck der Datenverarbeitung.</p>
    </div>
  </section>
</BaseLayout>
