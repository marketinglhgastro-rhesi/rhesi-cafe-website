---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";

// Firmenname (site.legal.companyName) aus Drittquellen recherchiert, Stand
// 2026-08-07 – vor Launch gegen aktuellen Firmenbuchauszug oder mit dem
// Steuerberater verifizieren (siehe auch impressum.astro).
---

<BaseLayout
  title="Datenschutz | Rhesi Café & Restaurant Lustenau"
  description="Datenschutzerklärung des Rhesi Café & Restaurant im Rheincenter Lustenau gemäß DSGVO."
>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Datenschutz</h1>
    <div class="mt-6 space-y-6 text-espresso/80 leading-relaxed">
      <p class="text-xs font-semibold uppercase tracking-wide text-terracotta-dark">
        noch anpassen
      </p>
      <p>
        Platzhaltertext: Hier Datenschutzerklärung
      </p>
      <h2 class="font-heading text-xl font-semibold text-brown">
        Verantwortlicher
      </h2>
      <p>
        {site.legal.companyName} (Betreiber von {site.name})<br />
        {site.address.street}, {site.address.addressExtra}<br />
        {site.address.postalCode} {site.address.city}, {site.address.country}<br />
        E-Mail: {site.email}
      </p>
      <h2 class="font-heading text-xl font-semibold text-brown">
        Datenverarbeitung
      </h2>
      <p>Platzhaltertext: Art, Umfang Zweck Datenverarbeitung.</p>
    </div>
  </section>
</BaseLayout>
