---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCategory from "../components/MenuCategory.astro";
import rawMenu from "../data/menu.json";

interface MenuItem {
  name: string;
  description?: string;
  price: string;
  allergens?: string[];
}

interface MenuCategoryData {
  title: string;
  note?: string;
  isPlaceholder?: boolean;
  items: MenuItem[];
  subsections?: { title: string; items: MenuItem[] }[];
}

interface MenuData {
  categories: MenuCategoryData[];
  allergenLegend: Record<string, string>;
}

const menu = rawMenu as MenuData;
---

<!-- TODO: /og/og-speisekarte.jpg noch erstellen (1200x630) -->
<BaseLayout
  title="Speisekarte | Rhesi Café & Restaurant Lustenau"
  description="Frühstück, Suppen, Hauptspeisen und mehr – die Speisekarte des Rhesi Café & Restaurant im Rheincenter Lustenau."
  ogImage="/og/og-speisekarte.jpg"
>
  <section class="bg-white py-16 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-heading text-4xl font-semibold text-brown">Speisekarte</h1>
      <p class="mt-4 text-espresso/70">
        Frühstück, herzhafte Gerichte, Suppen und Salate – für jeden
        Geschmack etwas dabei.
      </p>
    </div>
  </section>

  {
    menu.categories.map((category, index) => (
      <MenuCategory
        title={category.title}
        items={category.items}
        subsections={category.subsections}
        note={category.note}
        isPlaceholder={category.isPlaceholder}
        allergenLegend={category.title === "Frühstück" ? menu.allergenLegend : undefined}
        reveal={index % 2 === 0 ? "left" : "right"}
      />
    ))
  }

  <section class="mx-auto max-w-3xl px-6 pb-16 text-center">
    <p class="text-espresso/70">Feine Kuchen finden Sie in unserer Vitrine.</p>
    <p class="mt-4 text-xs text-espresso/70">
      Falls Sie eine Speisekarte mit Allergenen ergänzt wünschen, informieren
      Sie bitte unser Servicepersonal.
    </p>
  </section>
</BaseLayout>
