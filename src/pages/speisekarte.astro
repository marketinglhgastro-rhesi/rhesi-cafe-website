---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCategory from "../components/MenuCategory.astro";
import menu from "../data/menu.json";
---

<BaseLayout
  title="Speisekarte | Rhesi Café & Restaurant"
  description="Entdecken Sie unsere Speisekarte mit Kaffeespezialitäten, Frühstück, Hauptgerichten und hausgemachten Kuchen."
>
  <section class="bg-white py-16 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-heading text-4xl font-semibold text-brown">Speisekarte</h1>
      <p class="mt-4 text-espresso/70">
        Frühstück, Kaffeespezialitäten, hausgemachter Kuchen und herzhafte
        Gerichte – für jeden Geschmack etwas dabei.
      </p>
      <p class="mt-2 text-xs uppercase tracking-wide text-espresso/40">
        Beispieldaten – die tatsächliche Speisekarte folgt in Kürze
      </p>
    </div>
  </section>

  {menu.categories.map((category) => (
    <MenuCategory title={category.title} items={category.items} />
  ))}
</BaseLayout>
