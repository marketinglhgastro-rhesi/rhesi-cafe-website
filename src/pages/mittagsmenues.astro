---
import BaseLayout from "../layouts/BaseLayout.astro";
import WeeklyMenu from "../components/WeeklyMenu.astro";
import site from "../data/site.json";

// BEISPIELDATEN – Muster-Mittagsmenüs, bitte durch echte Wochenkarte ersetzen.
const week = [
  {
    day: "Montag",
    soup: "Cremige Kürbissuppe",
    options: [
      {
        name: "Menü 1: Schweinsbraten",
        description: "Mit Semmelknödel und Krautsalat",
        price: "€ 10,90",
      },
      {
        name: "Menü 2: Gemüsestrudel",
        description: "Mit Kartoffel-Salat",
        price: "€ 9,90",
      },
    ],
  },
  {
    day: "Dienstag",
    soup: "Klare Gemüsesuppe",
    options: [
      {
        name: "Menü 1: Hühnerschnitzel",
        description: "Mit Pommes und Preiselbeeren",
        price: "€ 10,50",
      },
      {
        name: "Menü 2: Gemüsecurry",
        description: "Mit Basmatireis",
        price: "€ 9,90",
      },
    ],
  },
  {
    day: "Mittwoch",
    soup: "Rindsuppe mit Frittaten",
    options: [
      {
        name: "Menü 1: Cordon Bleu",
        description: "Mit Petersilkartoffeln",
        price: "€ 11,90",
      },
      {
        name: "Menü 2: Käsespätzle",
        description: "Mit Röstzwiebeln und Salat",
        price: "€ 9,50",
      },
    ],
  },
  {
    day: "Donnerstag",
    soup: "Tomatensuppe",
    options: [
      {
        name: "Menü 1: Rindsgulasch",
        description: "Mit Semmelknödel",
        price: "€ 11,50",
      },
      {
        name: "Menü 2: Pasta Pomodoro",
        description: "Mit Parmesan und Basilikum",
        price: "€ 9,50",
      },
    ],
  },
  {
    day: "Freitag",
    soup: "Grießnockerlsuppe",
    options: [
      {
        name: "Menü 1: Gebackener Fisch",
        description: "Mit Erdäpfelsalat",
        price: "€ 11,50",
      },
      {
        name: "Menü 2: Gemischter Salat",
        description: "Mit Hausdressing und Baguette",
        price: "€ 8,90",
      },
    ],
  },
];
---

<BaseLayout
  title="Mittagsmenüs | Rhesi Café & Restaurant"
  description={`Unsere wechselnden Mittagsmenüs ${site.lunchMenu.days}, ${site.lunchMenu.hours} – täglich frisch gekocht im Rhesi Café & Restaurant in Lustenau.`}
>
  <section class="bg-white py-16 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-heading text-4xl font-semibold text-brown">
        Mittagsmenüs
      </h1>
      <p class="mt-4 text-espresso/70">
        {site.lunchMenu.days} servieren wir Ihnen täglich wechselnde
        Mittagsmenüs mit Suppe und Hauptspeise – frisch gekocht aus
        regionalen Zutaten. Änderungen vorbehalten.
      </p>
      <p class="mt-2 text-xs uppercase tracking-wide text-espresso/40">
        Beispieldaten – die tatsächliche Wochenkarte folgt in Kürze
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-14">
    <WeeklyMenu week={week} />
    <p class="mt-10 text-center text-sm text-espresso/60">
      Mittagsmenüs erhältlich {site.lunchMenu.days}, {site.lunchMenu.hours}.
    </p>
  </section>
</BaseLayout>
