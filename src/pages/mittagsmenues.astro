---
import BaseLayout from "../layouts/BaseLayout.astro";
import WeeklyMenu from "../components/WeeklyMenu.astro";
import site from "../data/site.json";
import lunch from "../data/mittagsmenue.json";

// Schema.org Menu/MenuSection JSON-LD so Google can potentially surface the
// daily lunch menu as a rich result. Prices are parsed from "€ 10,70" style
// strings in mittagsmenue.json into plain numbers for the Offer type.
const parsePrice = (price: string) => price.replace("€", "").replace(",", ".").trim();

const menuJsonLd = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: "Rhesi Mittagsmenü",
  description: `Wechselndes Mittagsmenü ${site.lunchMenu.days}, ${site.lunchMenu.hours}`,
  hasMenuSection: [
    {
      "@type": "MenuSection",
      name: "Vegi-Gerichte der Woche",
      hasMenuItem: lunch.vegiGerichteDerWoche.map((item) => ({
        "@type": "MenuItem",
        name: item.name,
        description: item.description,
        offers: {
          "@type": "Offer",
          price: parsePrice(item.price),
          priceCurrency: "EUR",
        },
      })),
    },
    {
      "@type": "MenuSection",
      name: "Tagesmenüs",
      hasMenuItem: lunch.days
        .filter((day) => day.dish)
        .map((day) => ({
          "@type": "MenuItem",
          name: `${day.day}: ${day.dish}`,
          offers: {
            "@type": "Offer",
            price: parsePrice(day.price as string),
            priceCurrency: "EUR",
          },
        })),
    },
  ],
};
---

<BaseLayout
  title="Mittagsmenü Lustenau – Mo–Fr 11–14 Uhr | Rhesi Café"
  description={`Täglich wechselndes Mittagsmenü in Lustenau: Suppe oder Salat, Hauptgericht und mehr – ${site.lunchMenu.days}, ${site.lunchMenu.hours} im Rhesi Café & Restaurant.`}
  ogImage="/og/og-mittagsmenue.jpg"
>
  <!-- TODO: /og/og-mittagsmenue.jpg noch erstellen (1200x630, mit Wochenmenü-Optik) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(menuJsonLd)} />

  <section class="bg-white py-16 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-heading text-4xl font-semibold text-brown">
        Mittagsmenüs
      </h1>
      <p class="mt-4 text-espresso/70">
        {site.lunchMenu.days} servieren wir Ihnen täglich ein wechselndes
        Mittagsmenü – frisch gekocht aus regionalen Zutaten. Änderungen
        vorbehalten.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-10">
    <h2 class="font-heading text-2xl font-semibold text-brown sm:text-3xl">
      Vegi-Gerichte der Woche
    </h2>
    <p class="mt-1 text-sm text-espresso/70">Täglich verfügbar</p>
    <ul class="mt-6 space-y-6">
      {
        lunch.vegiGerichteDerWoche.map((item) => (
          <li>
            <div class="flex items-baseline gap-2">
              <span class="font-heading font-medium text-espresso">
                {item.name}
              </span>
              <span class="flex-1 border-b border-dotted border-brown/30" />
              <span class="font-heading font-medium text-terracotta-dark">
                {item.price}
              </span>
            </div>
            {item.description && (
              <p class="mt-1 text-sm text-espresso/70">{item.description}</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-10">
    <h2 class="font-heading text-2xl font-semibold text-brown sm:text-3xl">
      Tagesmenüs
    </h2>
    <p class="mt-2 text-sm text-espresso/70">
      Jeweils zusätzlich: {lunch.supplement.name} – {lunch.supplement.price}
    </p>
    <div class="mt-8">
      <WeeklyMenu days={lunch.days} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 text-center">
    <p class="text-espresso/70">
      Mittagsmenüs erhältlich {site.lunchMenu.days}, {site.lunchMenu.hours}.
    </p>
    <p class="mt-4 text-xs text-espresso/70">
      Falls Sie eine Speisekarte mit Allergenen ergänzt wünschen, informieren
      Sie bitte unser Servicepersonal.
    </p>
  </section>
</BaseLayout>
