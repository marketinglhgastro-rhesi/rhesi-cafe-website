---
import BaseLayout from "../layouts/BaseLayout.astro";
import WeeklyMenu from "../components/WeeklyMenu.astro";
import site from "../data/site.json";
import lunch from "../data/mittagsmenue.json";
---

<BaseLayout
  title="Mittagsmenüs | Rhesi Café & Restaurant"
  description={`Unsere wechselnden Mittagsmenüs ${site.lunchMenu.days}, ${site.lunchMenu.hours} – täglich frisch gekocht im Rhesi Café & Restaurant in Lustenau.`}
>
  <section class="bg-white py-16 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-heading text-4xl font-semibold text-brown">
        Mittagsmenüs
      </h1>
      <p class="mt-4 text-espresso/70">
        {site.lunchMenu.days} servieren wir Ihnen täglich ein wechselndes
        Mittagsmenü – frisch gekocht aus regionalen Zutaten. Änderungen
        vorbehalten.
      </p>
      <p class="mt-2 text-xs uppercase tracking-wide text-espresso/40">
        Beispielhafte Wochenkarte – wird wöchentlich aktualisiert
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-10">
    <h2 class="font-heading text-2xl font-semibold text-brown sm:text-3xl">
      Vegi-Gerichte der Woche
    </h2>
    <p class="mt-1 text-sm text-espresso/60">Täglich verfügbar</p>
    <ul class="mt-6 space-y-6">
      {
        lunch.vegiGerichteDerWoche.map((item) => (
          <li>
            <div class="flex items-baseline gap-2">
              <span class="font-heading font-medium text-espresso">
                {item.name}
              </span>
              <span class="flex-1 border-b border-dotted border-brown/30" />
              <span class="font-heading font-medium text-terracotta">
                {item.price}
              </span>
            </div>
            {item.description && (
              <p class="mt-1 text-sm text-espresso/60">{item.description}</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-10">
    <h2 class="font-heading text-2xl font-semibold text-brown sm:text-3xl">
      Tagesmenüs
    </h2>
    <p class="mt-2 text-sm text-espresso/60">
      Jeweils zusätzlich: {lunch.supplement.name} – {lunch.supplement.price}
    </p>
    <div class="mt-8">
      <WeeklyMenu days={lunch.days} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 text-center">
    <p class="text-espresso/70">
      Mittagsmenüs erhältlich {site.lunchMenu.days}, {site.lunchMenu.hours}.
    </p>
    <p class="mt-4 text-xs text-espresso/50">
      Falls Sie eine Speisekarte mit Allergenen ergänzt wünschen, informieren
      Sie bitte unser Servicepersonal.
    </p>
  </section>
</BaseLayout>
