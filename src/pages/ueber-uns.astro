---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Über uns | Rhesi Café & Restaurant"
  description="Lernen Sie die Geschichte, das Team und die Philosophie des Rhesi Café & Restaurant in Lustenau kennen."
>
  <section class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Über uns</h1>
    <div class="mt-6 rounded-xl border border-dashed border-terracotta/50 bg-terracotta/5 p-4 text-sm text-espresso/70">
      <strong class="text-terracotta">Bitte anpassen:</strong> Der folgende
      Text ist ein Platzhalter. Ersetzen Sie ihn durch die echte Geschichte
      des Rhesi Café &amp; Restaurant (Gründung, Idee, was Sie besonders macht).
    </div>
    <p class="mt-6 text-espresso/80 leading-relaxed">
      Platzhaltertext: Hier steht die Geschichte des Rhesi Café &amp;
      Restaurant – Gründung, Philosophie und was uns besonders macht. Echte
      Inhalte folgen im nächsten Schritt.
    </p>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2">
      <!-- TODO: Platzhalterbild – vor Launch durch ein echtes Teamfoto ersetzen. -->
      <img
        src="https://placehold.co/800x600/4A3428/F5EDE4?text=Unser+Team"
        alt="Platzhalterbild: Team des Rhesi Café & Restaurant"
        class="w-full rounded-2xl object-cover"
      />
      <div>
        <h2 class="font-heading text-3xl font-semibold text-brown">
          Unser Team
        </h2>
        <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-terracotta">
          Bitte anpassen
        </p>
        <p class="mt-4 text-espresso/80 leading-relaxed">
          Platzhaltertext: Vorstellung des Teams hinter dem Rhesi Café &amp;
          Restaurant.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="font-heading text-3xl font-semibold text-brown">Philosophie</h2>
    <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-terracotta">
      Bitte anpassen
    </p>
    <p class="mt-4 text-espresso/80 leading-relaxed">
      Platzhaltertext: Unsere Werte rund um Qualität, Regionalität und
      Gastfreundschaft.
    </p>
  </section>
</BaseLayout>
