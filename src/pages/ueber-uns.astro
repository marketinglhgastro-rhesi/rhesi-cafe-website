---
import BaseLayout from "../layouts/BaseLayout.astro";
import SisterVenues from "../components/SisterVenues.astro";
---

<BaseLayout
  title="Über uns | Rhesi Café & Restaurant Lustenau"
  description="Erfahren Sie mehr über das Rhesi Café & Restaurant im Rheincenter Lustenau – unsere Geschichte, unser Team und was uns wichtig ist."
>
  <section class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Über uns</h1>
    <p class="mt-6 text-lg text-espresso/90 leading-relaxed sm:text-xl">
      Mitten im Rheincenter Lustenau eröffnete Gastronom Marcel Lerch im
      Sommer 2017 nach zweimonatigem Umbau das Rhesi Café &amp; Restaurant –
      nach Schmugglar, Piazza Azzurra und iTaly sein viertes Lokal in
      Lustenau. Der Name ist eine Anlehnung an die Rheinregulierung, die die
      Region geprägt hat.
    </p>
    <p class="mt-6 text-espresso/80 leading-relaxed">
      Das Café ist geprägt von hellen Pastelltönen, romantischen Mustern und
      einem leicht barocken Design, ergänzt durch einen Gastgarten. Das
      Angebot reicht von Frühstück über wechselnde Mittagsmenüs bis zu
      hausgemachten Torten und Pralinen aus der eigenen Konditorei.
    </p>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2">
      <!-- TODO: Platzhalterbild – vor Launch durch ein echtes Teamfoto ersetzen. -->
      <img
        src="https://placehold.co/800x600/4A3428/F5EDE4?text=Unser+Team"
        alt="Platzhalterbild: Team des Rhesi Café & Restaurant"
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl object-cover"
      />
      <div>
        <h2 class="font-heading text-3xl font-semibold text-brown">
          Unser Team
        </h2>
        <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-terracotta-dark">
          noch anpassen
        </p>
        <p class="mt-4 text-espresso/80 leading-relaxed">
          Platzhaltertext: Vorstellung Team
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20">
    <h2 class="font-heading text-3xl font-semibold text-brown">Philosophie</h2>
    <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-terracotta-dark">
      noch anpassen
    </p>
    <p class="mt-4 text-espresso/80 leading-relaxed">
      Platzhaltertext: Werte Qualität, Regionalität oder sachen die gut passen.
    </p>
  </section>

  <SisterVenues />
</BaseLayout>
