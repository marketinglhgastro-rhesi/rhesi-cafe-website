---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SisterVenues from "../components/SisterVenues.astro";
import gastgartenWeit from "../assets/images/gastgarten-weit.webp";
---

<BaseLayout
  title="Über uns | Rhesi Café & Restaurant Lustenau"
  description="Erfahren Sie mehr über das Rhesi Café & Restaurant im Rheincenter Lustenau – unsere Geschichte und was uns wichtig ist."
>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2">
    <div data-reveal="left">
      <h1 class="font-heading text-4xl font-semibold text-brown">Über uns</h1>
      <p class="mt-6 border-l-2 border-terracotta pl-4 text-xl text-espresso/90 leading-relaxed">
        Mitten im Rheincenter Lustenau haben wir einen Ort geschaffen, an dem
        Genuss auf Gemütlichkeit trifft. Seit 2017 lädt dich das Rhesi ein,
        den Alltag für einen Moment zu vergessen.
      </p>
      <p class="mt-6 text-espresso/80 leading-relaxed">
        Eröffnet wurde das Rhesi von Gastronom Marcel Lerch, der mit
        Schmugglar, Piazza Azzurra und iTaly schon drei weitere beliebte
        Lokale in der Region ins Leben gerufen hat. Der Name „Rhesi" ist
        dabei unsere Hommage an die bewegte Geschichte unserer Region – die
        Rheinregulierung.
      </p>
      <p class="mt-4 text-espresso/80 leading-relaxed">
        In unserem stilvollen Ambiente, das mit hellen Pastelltönen und einem
        Hauch Barock zum Verweilen einlädt, oder bei schönem Wetter auf
        unserer gemütlichen Terrasse, findest du deinen ganz persönlichen
        Genussmoment.
      </p>
      <p class="mt-4 text-espresso/80 leading-relaxed">
        Komm vorbei und genieße eine entspannte Zeit bei uns!
      </p>
    </div>
    <Image
      data-reveal="right"
      src={gastgartenWeit}
      alt="Sonniger Gastgarten des Rhesi Café & Restaurant mit Sitzplätzen unter Sonnenschirmen"
      width={700}
      height={560}
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
      class="h-72 w-full rounded-2xl object-cover md:h-full"
    />
  </section>

  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="font-heading text-3xl font-semibold text-brown">Philosophie</h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      <div data-reveal="up" class="rounded-2xl border border-brown/10 p-6 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-cream text-terracotta-dark">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
            <path d="M17 8h1a4 4 0 0 1 0 8h-1" />
            <path d="M3 8h14v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8Z" />
            <path d="M6 2v2M10 2v2M14 2v2" />
          </svg>
        </div>
        <p class="mt-4 font-heading text-lg font-semibold text-brown">Frühstück</p>
        <p class="mt-2 text-sm text-espresso/80 leading-relaxed">
          Starte mit einem ausgiebigen Frühstück entspannt in den Tag.
        </p>
      </div>

      <div data-reveal="up" style="transition-delay: 80ms" class="rounded-2xl border border-brown/10 p-6 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-cream text-terracotta-dark">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
          </svg>
        </div>
        <p class="mt-4 font-heading text-lg font-semibold text-brown">Mittagsmenü</p>
        <p class="mt-2 text-sm text-espresso/80 leading-relaxed">
          Freu dich auf ein abwechslungsreiches, wechselndes Mittagsmenü.
        </p>
      </div>

      <div data-reveal="up" style="transition-delay: 160ms" class="rounded-2xl border border-brown/10 p-6 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-cream text-terracotta-dark">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
            <path d="M4 21v-7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7" />
            <path d="M2 21h20" />
            <path d="M7 12v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" />
            <path d="M12 8V5" />
            <circle cx="12" cy="3.2" r="1.2" />
          </svg>
        </div>
        <p class="mt-4 font-heading text-lg font-semibold text-brown">Konditorei</p>
        <p class="mt-2 text-sm text-espresso/80 leading-relaxed">
          Gönn dir eine kleine Auszeit mit hausgemachten Torten und süßen
          Kleinigkeiten aus unserer eigenen Konditorei.
        </p>
      </div>
    </div>
  </section>

  <SisterVenues />
</BaseLayout>
