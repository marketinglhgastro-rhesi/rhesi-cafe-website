---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

const news = [
  {
    title: "Neue Frühstückskarte",
    text: "Platzhaltertext: Ankündigung der neuen Frühstückskarte mit saisonalen Zutaten.",
    image: "https://placehold.co/600x400/C87B4A/FFFDFB?text=Neuigkeit",
  },
  {
    title: "Sommerterrasse geöffnet",
    text: "Platzhaltertext: Unsere Terrasse ist ab sofort für die Sommersaison geöffnet.",
    image: "https://placehold.co/600x400/4A3428/F5EDE4?text=Neuigkeit",
  },
  {
    title: "Live-Musik Abend",
    text: "Platzhaltertext: Ankündigung eines besonderen Abends mit Live-Musik.",
    image: "https://placehold.co/600x400/241812/F5EDE4?text=Neuigkeit",
  },
];
---

<BaseLayout
  title="Aktuelles | Rhesi Café & Restaurant"
  description="Neuigkeiten, Veranstaltungen und saisonale Angebote aus dem Rhesi Café & Restaurant in Lustenau."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Aktuelles</h1>
    <p class="mt-4 max-w-2xl text-espresso/70">
      Platzhaltertext: Übersicht über Neuigkeiten und Veranstaltungen.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        news.map((item) => (
          <Card
            image={item.image}
            imageAlt={`Platzhalterbild: ${item.title}`}
            title={item.title}
            text={item.text}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
