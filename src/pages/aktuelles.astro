---
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import news from "../data/news.json";
import heroFruehstueck from "../assets/images/hero-fruehstueck-flatlay.webp";
import cardMittagsmenue from "../assets/images/card-mittagsmenue.webp";

// news.json holds image references as string keys (JSON can't hold ESM
// imports), resolved here to the actual optimized assets astro:assets needs.
const images: Record<string, ImageMetadata> = {
  "hero-fruehstueck-flatlay": heroFruehstueck,
  "card-mittagsmenue": cardMittagsmenue,
};

const dateFormatter = new Intl.DateTimeFormat("de-AT", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title="Aktuelles | Rhesi Café & Restaurant Lustenau"
  description="Neuigkeiten, Aktionen und saisonale Angebote aus dem Rhesi Café & Restaurant im Rheincenter Lustenau – immer aktuell informiert."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Aktuelles</h1>
    <p class="mt-4 max-w-2xl text-espresso/70">
      Neuigkeiten, Aktionen und Veranstaltungen aus dem Rhesi.
    </p>
    <p class="mt-2 text-xs uppercase tracking-wide text-espresso/70">
      Platzhalter-Einträge – echte Neuigkeiten folgen in Kürze
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        news.items.map((item) => (
          <Card
            image={images[item.image]}
            imageAlt={item.title}
            title={item.title}
            text={`${dateFormatter.format(new Date(item.date))} – ${item.description}`}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
