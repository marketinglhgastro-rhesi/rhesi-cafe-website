---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
---

<BaseLayout
  title="Impressum | Rhesi Café & Restaurant"
  description="Impressum des Rhesi Café & Restaurant in Lustenau."
>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="font-heading text-4xl font-semibold text-brown">Impressum</h1>
    <div class="mt-6 space-y-2 text-espresso/80 leading-relaxed">
      <p>{site.name}</p>
      <p>
        {site.address.street}, {site.address.addressExtra}<br />
        {site.address.postalCode} {site.address.city}, {site.address.country}
      </p>
      <p>Tel: {site.phone}</p>
      <p>E-Mail: {site.email}</p>
      <p class="pt-4 text-xs font-semibold uppercase tracking-wide text-terracotta">
        Bitte anpassen
      </p>
      <p>
        Platzhaltertext: Firmenbuchnummer, UID-Nummer, Rechtsform,
        Gewerbebehörde und Aufsichtsbehörde ergänzen.
      </p>
    </div>
  </section>
</BaseLayout>
