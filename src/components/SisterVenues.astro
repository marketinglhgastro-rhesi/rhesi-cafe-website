---
// Logos liegen unter public/images/betriebe/[slug].svg (bevorzugt, verlustfrei
// skalierbar) oder als PNG mit transparentem Hintergrund ab. KEIN JPG – JPG
// unterstützt keine Transparenz und würde auf der weißen Card als Rechteck
// mit Hintergrundfarbe auffallen. Sobald ein echtes Logo vorliegt, Datei
// unter dem jeweiligen Slug ablegen und den Pfad im logo-Feld eintragen,
// z.B. logo: "/images/betriebe/rio.svg". Bis dahin bleibt logo: null und
// die Karte zeigt den Anfangsbuchstaben-Platzhalter.
const venues = [
  {
    name: "Rio",
    slug: "rio",
    subtitle: "Café & Cocktailbar, Dornbirn",
    url: "https://www.rio-dornbirn.at",
    logo: null,
  },
  {
    name: "TacoTaco",
    slug: "tacotaco",
    subtitle: "Food & Drinks, Lustenau",
    url: "https://tacotaco.at",
    logo: null,
  },
  {
    name: "Mr. French",
    slug: "mr-french",
    subtitle: "Bistro & Bar, Dornbirn",
    url: "https://mrfrench.at",
    logo: null,
  },
  {
    name: "Schmugglar",
    slug: "schmugglar",
    subtitle: "Restaurant, Bar, Café, Lustenau",
    url: "https://schmugglar.at",
    logo: null,
  },
  {
    name: "Piazza Azzurra & iTaly",
    slug: "piazza-azzurra-italy",
    subtitle: "Pizzeria, Café & Bar",
    url: "https://azzurra.at",
    logo: null,
  },
];
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-5xl px-6 text-center">
    <h2 data-reveal="up" class="font-heading text-3xl font-semibold text-brown">
      Weitere Betriebe
    </h2>
    <p data-reveal="up" class="mx-auto mt-4 max-w-2xl text-espresso/70 leading-relaxed">
      Neben dem Rhesi betreiben wir weitere Lokale in der Region, die zum
      Genießen, Verweilen und Entdecken einladen. Ob Café, Bar oder
      kulinarischer Hotspot – wir glauben an Gastfreundschaft mit Charakter
      und Atmosphäre.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-6 text-left sm:grid-cols-2 lg:grid-cols-3">
      {
        venues.map((venue, index) => {
          const card = (
            <>
              {venue.logo ? (
                <img
                  src={venue.logo}
                  alt={`${venue.name} Logo`}
                  loading="lazy"
                  class="h-16 max-w-[140px] object-contain"
                />
              ) : (
                <div class="flex h-20 w-20 items-center justify-center rounded-xl bg-cream text-2xl font-semibold text-brown/40">
                  {venue.name.charAt(0)}
                </div>
              )}
              <p class="mt-4 font-heading text-lg font-semibold text-brown">
                {venue.name}
              </p>
              <p class="mt-1 text-sm text-espresso/70">{venue.subtitle}</p>
            </>
          );

          const cardClass =
            "group flex h-full flex-col items-start rounded-2xl border border-brown/10 p-6 transition-shadow";
          const style = `transition-delay: ${index * 80}ms`;

          return venue.url ? (
            <a
              data-reveal="up"
              style={style}
              href={venue.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`${cardClass} hover:shadow-md hover:border-brown/20`}
            >
              {card}
            </a>
          ) : (
            <div data-reveal="up" style={style} class={cardClass}>
              {card}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
