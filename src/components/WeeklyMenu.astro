---
interface DayMenu {
  day: string;
  date: string;
  dish?: string;
  price?: string;
  note?: string;
}

interface Props {
  days: DayMenu[];
}

const { days } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
  {
    days.map((dayMenu) => (
      <article class="flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-brown/10">
        <div class="bg-brown px-5 py-3">
          <h3 class="font-heading text-lg font-semibold text-white">
            {dayMenu.day}
          </h3>
          <p class="text-xs text-white/60">{dayMenu.date}</p>
        </div>
        <div class="flex flex-1 flex-col justify-center gap-3 p-5">
          {dayMenu.dish ? (
            <>
              <p class="font-heading font-medium text-espresso">
                {dayMenu.dish}
              </p>
              <p class="text-sm font-semibold text-terracotta">
                {dayMenu.price}
              </p>
            </>
          ) : (
            <p class="text-sm italic text-espresso/60">{dayMenu.note}</p>
          )}
        </div>
      </article>
    ))
  }
</div>
