---
interface Props {
  image?: string;
  imageAlt?: string;
  title: string;
  text: string;
  href?: string;
  linkLabel?: string;
}

const { image, imageAlt = "", title, text, href, linkLabel = "Mehr erfahren" } =
  Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-brown/10">
  {
    image && (
      <img
        src={image}
        alt={imageAlt}
        class="h-56 w-full object-cover"
        loading="lazy"
      />
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="font-heading text-xl font-semibold text-brown">{title}</h3>
    <p class="flex-1 text-sm leading-relaxed text-espresso/80">{text}</p>
    {
      href && (
        <a
          href={href}
          class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-terracotta hover:text-brown"
        >
          {linkLabel}
          <span aria-hidden="true">&rarr;</span>
        </a>
      )
    }
  </div>
</article>
