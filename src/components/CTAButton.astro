---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  onDark?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  onDark = false,
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold tracking-wide transition-colors duration-200";

const variants = {
  primary: "bg-terracotta-dark text-white hover:bg-brown",
  secondary:
    "border border-brown/40 text-brown hover:border-brown hover:bg-brown hover:text-white",
};

const variantsOnDark = {
  primary: "bg-terracotta-dark text-white hover:bg-white hover:text-espresso",
  secondary:
    "border border-white/70 text-white hover:border-white hover:bg-white hover:text-espresso",
};

const variantClasses = onDark ? variantsOnDark[variant] : variants[variant];
---

<a href={href} class={`${base} ${variantClasses} ${className}`}>
  <slot />
</a>
