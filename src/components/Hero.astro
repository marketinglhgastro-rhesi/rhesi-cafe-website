---
import CTAButton from "./CTAButton.astro";

interface CTA {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

interface Props {
  leftImage: string;
  leftImageAlt: string;
  rightImage: string;
  rightImageAlt: string;
  headline: string;
  subline?: string;
  ctas?: CTA[];
}

const {
  leftImage,
  leftImageAlt,
  rightImage,
  rightImageAlt,
  headline,
  subline,
  ctas = [],
} = Astro.props;
---

<section class="bg-cream">
  <div class="mx-auto grid max-w-6xl md:grid-cols-[1fr_1.4fr_1fr] md:items-stretch">
    <div class="order-2 h-64 md:order-1 md:h-auto">
      <img
        src={leftImage}
        alt={leftImageAlt}
        class="h-full w-full object-cover"
      />
    </div>

    <div class="order-1 flex flex-col items-center justify-center px-6 py-16 text-center md:order-2 md:px-10 md:py-24">
      <h1
        data-reveal
        class="font-heading max-w-lg text-4xl font-semibold text-brown sm:text-5xl"
      >
        {headline}
      </h1>
      {
        subline && (
          <p data-reveal class="mt-6 max-w-md text-espresso/70">
            {subline}
          </p>
        )
      }
      {
        ctas.length > 0 && (
          <div data-reveal class="mt-10 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
            {ctas.map((cta) => (
              <CTAButton href={cta.href} variant={cta.variant ?? "primary"}>
                {cta.label}
              </CTAButton>
            ))}
          </div>
        )
      }
    </div>

    <div class="order-3 h-64 md:h-auto">
      <img
        src={rightImage}
        alt={rightImageAlt}
        class="h-full w-full object-cover"
      />
    </div>
  </div>
</section>
