---
import CTAButton from "./CTAButton.astro";

interface CTA {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

interface Props {
  image: string;
  imageAlt: string;
  headline: string;
  subline?: string;
  ctas?: CTA[];
}

const { image, imageAlt, headline, subline, ctas = [] } = Astro.props;
---

<!-- TODO: Hero-Foto ist ein Unsplash-Platzhalter. Vor Launch durch ein eigenes Rhesi-Foto ersetzen. -->
<section class="relative flex min-h-[60vh] items-center overflow-hidden md:min-h-[85vh]">
  <img
    src={image}
    alt={imageAlt}
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div class="absolute inset-0 bg-espresso/20"></div>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at center, rgba(245,237,228,0.92) 0%, rgba(245,237,228,0.78) 40%, rgba(245,237,228,0.4) 65%, rgba(245,237,228,0.05) 100%);"
  >
  </div>

  <div
    data-reveal="up"
    class="relative mx-auto flex w-full max-w-3xl flex-col items-center px-6 py-20 text-center"
  >
    <h1 class="font-heading text-4xl font-semibold text-brown drop-shadow-sm sm:text-5xl md:text-6xl">
      {headline}
    </h1>
    {
      subline && (
        <p class="mt-6 max-w-xl text-lg text-espresso/90 drop-shadow-sm sm:text-xl">
          {subline}
        </p>
      )
    }
    {
      ctas.length > 0 && (
        <div class="mt-10 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
          {ctas.map((cta) => (
            <CTAButton href={cta.href} variant={cta.variant ?? "primary"}>
              {cta.label}
            </CTAButton>
          ))}
        </div>
      )
    }
  </div>
</section>
