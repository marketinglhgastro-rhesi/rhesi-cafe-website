---
const openingHours = [
  { day: "Montag", hours: "Ruhetag" },
  { day: "Dienstag", hours: "08:00 – 18:00" },
  { day: "Mittwoch", hours: "08:00 – 18:00" },
  { day: "Donnerstag", hours: "08:00 – 18:00" },
  { day: "Freitag", hours: "08:00 – 22:00" },
  { day: "Samstag", hours: "09:00 – 22:00" },
  { day: "Sonntag", hours: "09:00 – 14:00" },
];
---

<div class="grid gap-10 md:grid-cols-2">
  <div class="space-y-6">
    <div>
      <h3 class="font-heading text-lg font-semibold text-brown">Adresse</h3>
      <p class="mt-1 text-sm text-espresso/80">
        Rhesi Café &amp; Restaurant<br />
        Kapellenstraße 1<br />
        6890 Lustenau, Österreich
      </p>
    </div>
    <div>
      <h3 class="font-heading text-lg font-semibold text-brown">Kontakt</h3>
      <p class="mt-1 text-sm text-espresso/80">
        Tel: <a href="tel:+435577000000" class="hover:text-terracotta">+43 5577 000000</a><br />
        E-Mail: <a href="mailto:info@rhesi-cafe.at" class="hover:text-terracotta">info@rhesi-cafe.at</a>
      </p>
    </div>
    <div>
      <h3 class="font-heading text-lg font-semibold text-brown">Öffnungszeiten</h3>
      <table class="mt-2 w-full max-w-xs text-sm text-espresso/80">
        <tbody>
          {
            openingHours.map((entry) => (
              <tr class="border-b border-brown/10 last:border-0">
                <td class="py-1.5 pr-4 font-medium text-espresso">{entry.day}</td>
                <td class="py-1.5 text-right">{entry.hours}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="min-h-[320px] overflow-hidden rounded-2xl ring-1 ring-brown/10">
    <iframe
      title="Standort Rhesi Café & Restaurant"
      src="https://www.google.com/maps?q=Kapellenstra%C3%9Fe+1,+6890+Lustenau,+%C3%96sterreich&output=embed"
      class="h-full min-h-[320px] w-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</div>
