---
import { Image } from "astro:assets";
import site from "../data/site.json";
import gastgartenDetail from "../assets/images/gastgarten-detail.webp";

const mapsUrl = `https://maps.google.com/?q=${encodeURIComponent(site.address.mapQuery)}`;
---

<div class="grid gap-10 md:grid-cols-2">
  <div data-reveal="left" class="space-y-6">
    <div>
      <h2 class="font-heading text-lg font-semibold text-brown">Adresse</h2>
      <p class="mt-1 text-sm text-espresso/80">
        {site.name}<br />
        {site.address.street}, {site.address.addressExtra}<br />
        {site.address.postalCode} {site.address.city}, {site.address.country}
      </p>
    </div>
    <div>
      <h2 class="font-heading text-lg font-semibold text-brown">Kontakt</h2>
      <p class="mt-1 text-sm text-espresso/80">
        Tel: <a href={site.phoneHref} class="hover:text-terracotta">{site.phone}</a><br />
        E-Mail: <a href={`mailto:${site.email}`} class="hover:text-terracotta">{site.email}</a>
      </p>
    </div>
    <div>
      <h2 class="font-heading text-lg font-semibold text-brown">Öffnungszeiten</h2>
      <table class="mt-2 w-full max-w-xs text-sm text-espresso/80">
        <tbody>
          {
            site.openingHours.map((entry) => (
              <tr class="border-b border-brown/10 last:border-0">
                <td class="py-1.5 pr-4 font-medium text-espresso">{entry.day}</td>
                <td class="py-1.5 text-right">{entry.hours}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-sm text-espresso/70">
        Mittagsmenü: {site.lunchMenu.days}, {site.lunchMenu.hours}
      </p>
    </div>
    <Image
      src={gastgartenDetail}
      alt="Gastgarten-Sitzbereich mit Blick auf den RHESI-Schriftzug am Fenster"
      width={500}
      height={375}
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
      class="h-40 w-full rounded-2xl object-cover"
    />
  </div>

  <div
    data-reveal="right"
    class="flex min-h-[320px] flex-col items-center justify-center gap-4 rounded-2xl bg-cream p-8 text-center ring-1 ring-brown/10"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10 text-terracotta-dark">
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
      <circle cx="12" cy="10" r="3" />
    </svg>
    <div>
      <p class="font-heading text-lg font-semibold text-brown">{site.name}</p>
      <p class="mt-1 text-sm text-espresso/80">
        {site.address.street}, {site.address.addressExtra}<br />
        {site.address.postalCode} {site.address.city}
      </p>
    </div>
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full border border-brown/40 px-6 py-3 text-sm font-semibold tracking-wide text-brown transition-colors duration-200 hover:border-brown hover:bg-brown hover:text-white"
    >
      In Google Maps öffnen
    </a>
    <p class="text-xs text-espresso/50">
      Öffnet Google Maps in einem neuen Tab – es werden keine Daten an
      Google übertragen, bevor Sie klicken.
    </p>
  </div>
</div>
