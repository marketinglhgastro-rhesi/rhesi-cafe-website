---
import { Image } from "astro:assets";
// TODO: Fotos sind Unsplash-Platzhalter. Vor Launch durch eigene Rhesi-Fotos ersetzen.
import atmosphaere1 from "../assets/images/atmosphaere-1.png";
import atmosphaere2 from "../assets/images/atmosphaere-2.png";
import atmosphaere3 from "../assets/images/atmosphaere-3.png";
import atmosphaere4 from "../assets/images/atmosphaere-4.png";

const photos = [
  { src: atmosphaere1, alt: "Gemütliche Sitzecke im Rhesi" },
  { src: atmosphaere2, alt: "Gastraum im Rhesi" },
  { src: atmosphaere3, alt: "Bar-Bereich im Rhesi" },
  { src: atmosphaere4, alt: "Gemütlicher Fensterplatz im Rhesi" },
];
---

<section class="bg-cream py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal="up" class="text-center">
      <h2 class="font-heading text-3xl font-semibold text-brown">
        Ein Blick ins Rhesi
      </h2>
      <p class="mt-3 text-espresso/70">
        Gemütliche Atmosphäre mitten in Lustenau.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        photos.map((photo, index) => (
          <div
            data-reveal="up"
            style={`transition-delay: ${index * 100}ms`}
            class="group h-64 overflow-hidden rounded-2xl shadow-sm ring-1 ring-brown/10"
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              width={700}
              height={560}
              format="webp"
              quality={80}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
