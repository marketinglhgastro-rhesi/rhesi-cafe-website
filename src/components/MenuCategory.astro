---
interface MenuItem {
  name: string;
  description?: string;
  price: string;
  allergens?: string[];
}

interface SubSection {
  title: string;
  items: MenuItem[];
}

interface Props {
  title: string;
  items: MenuItem[];
  subsections?: SubSection[];
  note?: string;
  isPlaceholder?: boolean;
  allergenLegend?: Record<string, string>;
  reveal?: "up" | "left" | "right";
}

const { title, items, subsections, note, isPlaceholder, allergenLegend, reveal } =
  Astro.props;
---

<section data-reveal={reveal} class="mx-auto max-w-3xl px-6 py-10">
  {
    note && (
      <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-terracotta">
        {note}
      </p>
    )
  }
  <div class="flex items-baseline gap-3">
    <h2 class="font-heading text-2xl font-semibold text-brown sm:text-3xl">
      {title}
    </h2>
    {
      isPlaceholder && (
        <span class="text-xs uppercase tracking-wide text-espresso/40">
          Beispieldaten
        </span>
      )
    }
  </div>

  <ul class="mt-8 space-y-6">
    {
      items.map((item) => (
        <li>
          <div class="flex items-baseline gap-2">
            <span class="font-heading font-medium text-espresso">
              {item.name}
            </span>
            <span class="flex-1 border-b border-dotted border-brown/30" />
            <span class="font-heading font-medium text-terracotta">
              {item.price}
              {item.allergens && (
                <sup class="ml-0.5 text-[0.6rem] font-normal text-espresso/40">
                  {item.allergens.join(",")}
                </sup>
              )}
            </span>
          </div>
          {item.description && (
            <p class="mt-1 text-sm text-espresso/60">{item.description}</p>
          )}
        </li>
      ))
    }
  </ul>

  {
    subsections && subsections.length > 0 && (
      <div class="mt-10 space-y-8">
        {subsections.map((sub) => (
          <div class="border-t border-brown/10 pt-6">
            <h3 class="font-heading text-lg font-medium text-brown">
              {sub.title}
            </h3>
            <ul class="mt-4 space-y-4 pl-2">
              {sub.items.map((item) => (
                <li>
                  <div class="flex items-baseline gap-2">
                    <span class="text-sm font-medium text-espresso">
                      {item.name}
                    </span>
                    <span class="flex-1 border-b border-dotted border-brown/20" />
                    <span class="text-sm font-medium text-terracotta">
                      {item.price}
                      {item.allergens && (
                        <sup class="ml-0.5 text-[0.6rem] font-normal text-espresso/40">
                          {item.allergens.join(",")}
                        </sup>
                      )}
                    </span>
                  </div>
                  {item.description && (
                    <p class="mt-0.5 text-xs text-espresso/50">
                      {item.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  {
    allergenLegend && (
      <div class="mt-10 border-t border-brown/10 pt-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-espresso/40">
          Allergene
        </p>
        <div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-0.5 text-xs text-espresso/50 sm:grid-cols-3">
          {Object.entries(allergenLegend).map(([code, label]) => (
            <span>
              <span class="font-semibold text-espresso/70">{code}</span> {label}
            </span>
          ))}
        </div>
      </div>
    )
  }
</section>
