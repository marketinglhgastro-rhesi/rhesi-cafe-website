---
const year = new Date().getFullYear();

const openingHoursShort = [
  { day: "Di – Do", hours: "08:00 – 18:00" },
  { day: "Fr – Sa", hours: "08:00 – 22:00" },
  { day: "So", hours: "09:00 – 14:00" },
  { day: "Mo", hours: "Ruhetag" },
];
---

<footer class="bg-espresso text-cream">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-heading text-lg text-white">Rhesi Café &amp; Restaurant</p>
      <p class="mt-3 text-sm text-cream/70">
        Kapellenstraße 1<br />
        6890 Lustenau, Österreich
      </p>
    </div>

    <div>
      <h3 class="font-heading text-sm font-semibold text-white">Kontakt</h3>
      <p class="mt-3 text-sm text-cream/70">
        <a href="tel:+435577000000" class="hover:text-terracotta">+43 5577 000000</a><br />
        <a href="mailto:info@rhesi-cafe.at" class="hover:text-terracotta">info@rhesi-cafe.at</a>
      </p>
    </div>

    <div>
      <h3 class="font-heading text-sm font-semibold text-white">Öffnungszeiten</h3>
      <ul class="mt-3 space-y-1 text-sm text-cream/70">
        {
          openingHoursShort.map((entry) => (
            <li class="flex justify-between gap-4">
              <span>{entry.day}</span>
              <span>{entry.hours}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="font-heading text-sm font-semibold text-white">Folgen Sie uns</h3>
      <div class="mt-3 flex gap-4">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-cream/70 hover:text-terracotta"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.01 3.66 9.17 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.77 8.44-4.93 8.44-9.94Z" />
          </svg>
        </a>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-cream/70 hover:text-terracotta"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.15.55.55.89 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45.53C6.09.28 6.82.11 7.88.06 8.94.01 9.28 0 12 0Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.25a3.25 3.25 0 1 1 0-6.5 3.25 3.25 0 0 1 0 6.5ZM17.4 4.6a1.17 1.17 0 1 0 0 2.34 1.17 1.17 0 0 0 0-2.34Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-6 text-xs text-cream/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Rhesi Café &amp; Restaurant. Alle Rechte vorbehalten.</p>
      <div class="flex gap-4">
        <a href="/datenschutz" class="hover:text-terracotta">Datenschutz</a>
        <a href="/impressum" class="hover:text-terracotta">Impressum</a>
      </div>
    </div>
  </div>
</footer>
